# Root Monorepo Configuration Template for myRmyC (myresume mycareer)
# Copy to apps/server/.env and configure your cloud services.

# Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon Cloud Serverless PostgreSQL Database Connection
# Obtain pooled and unpooled connection URIs from https://console.neon.tech
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-id>.neon.tech/<dbname>?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-direct-id>.neon.tech/<dbname>?sslmode=require"
NEON_BRANCH=production

# JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET="your-jwt-access-secret-32-chars-min"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-32-chars-min"

# Google Gemini API Key (Gemini 2.5 Flash ATS & Bullet Optimization)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
